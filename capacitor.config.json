{
  "appId": "com.focusflow.app",
  "appName": "FocusFlow",
  "webDir": "app",
  "backgroundColor": "#0b0e1a",
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_notify",
      "iconColor": "#6366F1"
    },
    "SplashScreen": {
      "backgroundColor": "#0b0e1a",
      "launchShowDuration": 0,
      "launchAutoHide": true
    }
  }
}
