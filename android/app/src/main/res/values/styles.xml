<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: dark, brand-chrome status/navigation bars,
         no action bar (the WebView renders the whole UI). -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/ff_navy</item>
        <item name="android:statusBarColor">@color/ff_navy</item>
        <item name="android:navigationBarColor">@color/ff_navy</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Launch/splash theme.
         Pre-Android 12: full-bleed @drawable/splash bitmap.
         Android 12+: androidx core-splashscreen shows the adaptive icon on
         the brand navy background (windowSplashScreen* attributes). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/ff_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>
</resources>
